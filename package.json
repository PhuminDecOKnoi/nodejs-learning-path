{
  "name": "nodejs-learning-path",
  "version": "2.0.0",
  "private": true,
  "description": "Consolidated Node.js learning repository covering fundamentals, Express, EJS, MySQL, Socket.IO and practical game projects.",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "start": "node examples/express-ejs/src/app.js",
